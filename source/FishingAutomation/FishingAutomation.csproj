<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>0.1.92</Version>
    <AssemblyVersion>0.1.92.0</AssemblyVersion>
    <FileVersion>0.1.92.0</FileVersion>
    <RunAnalyzers>false</RunAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GatheringLocalPreview)' == 'true'">
    <DefineConstants>$(DefineConstants);GATHERING_LOCAL_PREVIEW</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ui\reference.png" LogicalName="FishingAutomation.ReferenceArtwork.png" Condition="Exists('ui\reference.png')" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260627" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="templates\*.png;templates\*.jpg;templates\*.jpeg;templates\*.bmp" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="config.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="notification.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="interception.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('interception.dll')" />
    <Content Include="dungeon\config\*.json;dungeon\templates\*.png;dungeon\templates\*.jpg;dungeon\templates\*.jpeg;dungeon\templates\*.bmp" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="abyss\config\*.json;abyss\templates\*.png;abyss\templates\*.jpg;abyss\templates\*.jpeg;abyss\templates\*.bmp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="visual-tests\assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="abyss\previews\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="abyss\templates\loot_v173\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
