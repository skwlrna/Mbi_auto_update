    {
      "Target": "abyss_potion_popup_title",
      "Action": "escape",
      "CooldownMs": 3000,
      "ScanIntervalMs": 500
    },
    {
      "Target": "abyss_popup_close",
      "Action": "escape",
      "CooldownMs": 3000,
      "ScanIntervalMs": 700
    },
    {
      "Target": "scene_skip",
